# Database
DATABASE_URL=postgres://user:password@localhost:5432/kbr_api
TEST_DB_URL=postgresql://user:password@localhost:5432/kbr_test

# Auth
JWT_SECRET=

# Server
BIND_ADDR=127.0.0.1:8181

# CORS
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Frontend (for email links)
FRONTEND_URL=http://localhost:3000

# Application host (for API URLs in emails)
APPLICATION_HOST=localhost:8181

# SMTP (email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com

# Shopify
SHOPIFY_STORE=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_KBR_ID=

# Mailchimp
MAILCHIMP_API_KEY=

# S3 / Storage
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=

# Google Safe Browsing
GOOGLE_SAFE_BROWSING_API_KEY=

# Deploy webhook (for deploy_webhook binary)
GITHUB_WEBHOOK_SECRET=
WEBHOOK_BIND_ADDR=127.0.0.1:9999
DEPLOY_LOG_PATH=deploy.log
